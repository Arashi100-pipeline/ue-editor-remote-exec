<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>UE Editor Remote Exec - Third-party licenses</title>
    <style>
        body { font-family: sans-serif; margin: 0; padding: 2rem; line-height: 1.45; }
        main { max-width: 960px; margin: 0 auto; }
        pre { white-space: pre-wrap; padding: 1rem; background: #f4f4f4; overflow: auto; }
        @media (prefers-color-scheme: dark) {
            body { background: #202124; color: #f1f3f4; }
            a { color: #8ab4f8; }
            pre { background: #303134; }
        }
    </style>
</head>
<body>
<main>
    <h1>Third-party licenses</h1>
    <p>Generated from the locked Rust dependency graph for the Windows release.</p>
    <h2>Overview</h2>
    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
        {{/each}}
    </ul>
    {{#each licenses}}
    <section>
{{#if first_of_kind}}        <h2 id="{{id}}">{{name}}</h2>{{/if}}
        <h3>{{name}}</h3>
        <p>Used by:</p>
        <ul>
            {{#each used_by}}
            <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
            {{/each}}
        </ul>
        <pre>{{text}}</pre>
    </section>
    {{/each}}
</main>
</body>
</html>
